--  Customer Dimension

-- Distribution by country, gender, material_status
SELECT  country, COUNT(*) AS total_customers FROM gold.dim_customer GROUP BY country;
-- country = 7
SELECT  gender, COUNT(*) AS total_customers FROM gold.dim_customer GROUP BY gender;
-- gender = 2
SELECT  material_status, COUNT(*) AS total_customers FROM gold.dim_customer GROUP BY material_status;
-- material_status = 2

-- Any missing birthdate values? What's the age range?
SELECT birthdate FROM gold.dim_customer WHERE birthdate IS NULL;
-- 17 missing birthdate
SELECT
MIN(DATEDIFF(year, birthdate, GETDATE())) AS youngest,
MAX(DATEDIFF(year, birthdate, GETDATE())) AS oldest,
AVG(DATEDIFF(year, birthdate, GETDATE())) AS avg_age
FROM gold.dim_customer;
-- youngest customer = 40, oldest customer = 110, avg_ag = 57

-- How many customers have never placed an order?
SELECT 
customer_key
FROM gold.dim_customer
WHERE customer_key NOT IN(SELECT customer_key FROM gold.fact_sales );
-- No results
