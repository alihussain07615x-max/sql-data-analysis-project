-- Explore all objects in the database
SELECT * FROM INFORMATION_SCHEMA.TABLES  WHERE TABLE_SCHEMA = 'gold';


-- Explore all columns in the database
SELECT * FROM INFORMATION_SCHEMA.COLUMNS  WHERE TABLE_SCHEMA = 'gold';
-- Row Counts & Basic Volume

-- How many records are in fact_sales, dim_customer, and dim_products?
SELECT
COUNT(*) AS total_records
FROM gold.fact_sales;
-- Results total records = 60398
SELECT
COUNT(*) AS total_records
FROM gold.dim_customer;
-- Results total records = 18484
SELECT
COUNT(*) AS total_records
FROM gold.dim_products;
-- Results total records = 295


-- Are there customers or products that have no sales at all? (orphaned dimension records)

SELECT
f.customer_key,
c.first_name,
f.sales_amount
FROM gold.dim_customer c
FULL JOIN gold.fact_sales f
ON c.customer_key = f.customer_key
WHERE f.sales_amount = 0 OR f.sales_amount IS NULL;
-- No results

SELECT
COUNT(*) OVER() AS total_products,
f.product_key,
p.product_name,
f.sales_amount
FROM gold.dim_products p
FULL JOIN gold.fact_sales f
ON p.product_key = f.product_key
WHERE f.sales_amount = 0 OR f.sales_amount IS NULL;
-- 165 products that have no sales at all


-- ================================================================================
--  Data Quality Checks

-- NULLs: Check every column, especially shipping_date, due_date, price, quantity, sales_amount
SELECT
*
FROM gold.fact_sales
WHERE due_date IS NULL OR shipping_date IS NULL OR price IS NULL OR quantity IS NULL OR sales_amount IS NULL ;
-- No results 

-- Referential integrity: Do all customer_key and product_key in fact_sales actually exist in their dimension tables?
SELECT
customer_key,
product_key
FROM gold.fact_sales
WHERE customer_key NOT IN  (SELECT customer_key FROM gold.dim_customer)
OR product_key NOT IN (SELECT product_key FROM gold.dim_products);
-- No results 

-- Negative or zero values: Any rows where price <= 0 or quantity <= 0?
SELECT
price,
quantity
FROM gold.fact_sales
WHERE price <= 0 OR quantity <=0;
-- No results 

-- Consistency check: Does sales_amount always equal quantity * price, or are there discrepancies?

SELECT
sales_amount
FROM gold.fact_sales
WHERE sales_amount != quantity * price;
-- No results 

-- ================================================================================
--  Date Range & Time Coverage

-- What is the min and max of order_date? How many years does the data span?
SELECT
MIN(order_date) AS first_order,
MAX(order_date) AS last_order,
DATEDIFF(year,MIN(order_date),MAX(order_date)) AS years_span
FROM gold.fact_sales;
-- first_order = 2010-12-29, last_order = 2014-01-28, years_span = 4

-- Are there orders where shipping_date < order_date (impossible dates)?
SELECT 
shipping_date,
order_date
FROM gold.fact_sales
WHERE shipping_date < order_date;
-- No results

-- Are there orders where due_date < shipping_date?
SELECT 
due_date,
shipping_date
FROM gold.fact_sales
WHERE due_date < shipping_date;
-- No results

