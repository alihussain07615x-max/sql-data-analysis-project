/*
=====================================================================================
Customer report
=====================================================================================
purpose:
  - This riport consolidates key customer metrics and behaviors

Highlights:
1. Gathers essential fields such as names, ages, and transaction details.
2. Segments customers into categries (VIP, Regular, New) and age groups.
3. Aggregates customers level metrics:
  - total orders
  - total quantity purchesed
  - total producta
  - lifspan (in month)
4. Calculates valuable KPIS:
  - recency (mounths since last order)
  - avarage order value
  - avarage monthly spend
=====================================================================================  
*/


CREATE or ALTER VIEW gold.report_customers AS

WITH  customer_info AS (
SELECT 
f.customer_key,
CONCAT(c.first_name,' ',c.last_name) AS full_name,
DATEDIFF(YEAR, c.birthdate, GETDATE()) AS age,
DATEDIFF(month, MIN(order_date), MAX(order_date)) AS lifespan,
COUNT(f.order_number) AS total_orders,
SUM(f.sales_amount) AS total_spending,
COUNT(p.product_name) AS total_producte,
SUM(f.quantity) AS total_quantity,
MIN(order_date) AS first_order,
MAX(order_date) AS last_order,
AVG(sales_amount)  AS avg_sales

FROM gold.fact_sales f
LEFT JOIN gold.dim_customer c
ON c.customer_key = f.customer_key
LEFT JOIN gold.dim_products p
ON p.product_key = f.product_key
GROUP BY f.customer_key, CONCAT(c.first_name,' ',c.last_name), DATEDIFF(YEAR, c.birthdate, GETDATE())
)

SELECT
customer_key,
full_name,
age,
CASE WHEN age BETWEEN 20 AND 29 THEN '20-29'
     WHEN age BETWEEN 30 AND 39 THEN '30-39'
	 WHEN age BETWEEN 40 AND 49 THEN '40-49'
	 ELSE '50 and above'
END AS age_group,
lifespan,
total_orders,
total_spending,
total_producte,
CASE WHEN lifespan >= 12 AND total_spending > 5000 THEN 'VIP'
		 WHEN lifespan >= 12 AND total_spending <= 5000 THEN 'Regular'
		 ELSE 'New'
END customer_segment,

DATEDIFF(month, last_order, GETDATE()) AS recency,
CASE WHEN total_spending = 0 THEN 0
ELSE total_spending / total_orders 
END AS avg_order_value,
CASE WHEN total_spending = 0 or lifespan = 0 THEN 0
ELSE total_spending / lifespan 
END AS avg_monthly_send

FROM customer_info
